(text "Right-medium 4.7k -> 0.320; left-medium 47k -> 0.825 of VEXC. The app must refuse a mismatched side." (exclude_from_sim no) (at 20.32 157.2 0) (effects (font (size 1.2 1.2)) (justify left bottom)) (uuid "3bdbad8f-c83e-5534-8e43-f6d7431056c2"))
